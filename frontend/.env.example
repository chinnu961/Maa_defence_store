# Base URL for the FastAPI backend's REST API.
#
# Dev default: leave unset. Vite's dev server proxies "/api" straight to
# http://localhost:8000 (see vite.config.js), so the app talks to the FastAPI
# backend without any CORS issues.
#
# Production: point this at your deployed backend, e.g.
#   VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=http://127.0.0.1:8000
