# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:root@localhost:5432/maa_defence

# JWT
SECRET_KEY=change-this-to-a-long-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First admin account, created automatically on first startup if it doesn't exist
FIRST_ADMIN_EMAIL=admin@maadefencestores.com
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=Store Admin
